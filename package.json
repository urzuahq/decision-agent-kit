{
  "name": "decision-agent-kit",
  "version": "0.1.0",
  "private": true,
  "description": "Tooling for coding-agent harnesses to ask a decision model about the session: is the work really done? Claude Code and SubQ Snap today; more harnesses and models planned.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "type-check": "tsc -p tsconfig.json && tsc -p tsconfig.hooks.json",
    "lint:check": "eslint .",
    "lint:write": "eslint . --fix",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0",
    "vitest": "^3.0.0"
  }
}
